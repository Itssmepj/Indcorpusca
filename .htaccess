# ----------------------------------------------------------------------
# INDCORPUSCA - Clean URLs & Server Configuration (Hostinger / Apache / LiteSpeed)
# ----------------------------------------------------------------------

# Prevent directory browsing
Options -Indexes

# Disable MultiViews so mod_rewrite takes priority
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirect /index or /index.html to root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/*index(?:\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # 2. Redirect any request with .html extension to clean URL (removes .html in browser)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # 3. Internally route clean URL to existing .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html
